{
  "$id": "https://agent-skills.dev/schemas/skill-hooks/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "hooks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "argv": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "event": {
            "enum": [
              "session-start",
              "stop"
            ]
          },
          "hosts": {
            "items": {
              "enum": [
                "claude-code",
                "codex"
              ]
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "id": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          }
        },
        "required": [
          "argv",
          "event",
          "hosts",
          "id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schemaVersion": {
      "const": "skill-hooks/1"
    }
  },
  "required": [
    "hooks",
    "schemaVersion"
  ],
  "type": "object"
}
