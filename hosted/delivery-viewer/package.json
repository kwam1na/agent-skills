{
  "name": "@agent-skills/hosted-delivery-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "generate": "node scripts/generate-validator.mjs && wrangler types",
    "typecheck": "npm run generate && tsc --noEmit",
    "build": "npm run generate && wrangler deploy --dry-run --outdir dist",
    "test": "node scripts/generate-validator.mjs && vitest run",
    "dev": "npm run generate && wrangler dev --ip 127.0.0.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.2",
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.162.0"
  }
}
