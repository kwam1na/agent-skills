{
  "name": "@agent-skills/hosted-delivery-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "generate:core": "node scripts/generate-validator.mjs && node scripts/build-assets.mjs",
    "generate": "npm run generate:core && wrangler types",
    "typecheck": "npm run generate && tsc --noEmit && tsc --noEmit -p tsconfig.core.json",
    "build": "npm run generate && wrangler deploy --dry-run --outdir dist",
    "test": "npm run generate:core && vitest run && vitest run -c vitest.ui.config.ts",
    "dev": "npm run generate && wrangler dev --ip 127.0.0.1",
    "test:browser": "npm run build && playwright test",
    "test:worker": "npm run generate:core && vitest run",
    "test:viewer": "npm run generate:core && vitest run -c vitest.ui.config.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.2",
    "@playwright/test": "1.65.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "jsdom": "31.0.1",
    "miniflare": "5.20261113.0-beta",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.162.0"
  }
}
