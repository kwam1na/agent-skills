{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": [
    "src/node/**/*.ts",
    "src/core/**/*.ts",
    "src/protocol.ts",
    "src/projection-v2.ts",
    "src/generated-assets.ts",
    "src/generated-validator.js",
    "src/generated-validator-v2.js"
  ],
  "exclude": ["src/core/node-crypto.d.ts"]
}
