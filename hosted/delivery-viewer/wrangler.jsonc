{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hosted-delivery-viewer",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DELIVERIES",
        "class_name": "DeliveryObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DeliveryObject"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "hosted-delivery-snapshots"
    }
  ],
  "secrets": {
    "required": [
      "PUBLISHERS"
    ]
  },
  "routes": [
    {
      "pattern": "deliveries.v26technologies.com",
      "custom_domain": true
    }
  ]
}
