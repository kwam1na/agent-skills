{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "types": [
      "@cloudflare/vitest-plugin/types",
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/generated-validator.js",
    "test/**/*.ts",
    "worker-configuration.d.ts",
    "vitest.config.ts"
  ]
}
