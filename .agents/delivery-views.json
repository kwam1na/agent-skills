{
  "spec": "delivery-views-config/1",
  "title": "Adoption gaps",
  "tracker": {
    "name": "Linear",
    "issueUrl": "https://linear.app/v26-technologies/issue/{key}",
    "keyPattern": "^V26-[0-9]+$"
  },
  "forges": [
    {
      "name": "GitHub",
      "repository": "kwam1na/agent-skills",
      "pullUrl": "https://github.com/{repository}/pull/{number}",
      "commitUrl": "https://github.com/{repository}/commit/{sha}"
    }
  ],
  "lenses": {
    "lens.outcome-correctness": {
      "name": "Correctness"
    },
    "lens.adversarial-testing": {
      "name": "Testing"
    },
    "outcome-correctness": {
      "name": "Correctness",
      "icon": "bullseye"
    },
    "adversarial": {
      "name": "Adversarial",
      "icon": "spy"
    }
  },
  "scrubEnv": [
    "LINEAR_API_KEY",
    "GITHUB_TOKEN"
  ]
}
