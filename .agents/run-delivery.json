{
  "schemaVersion": "delivery-flow/1",
  "branchPattern": "claude/{key}",
  "gates": [
    {
      "id": "validate-registry",
      "argv": [
        "python3",
        "-B",
        "scripts/validate-registry.py"
      ],
      "timeoutSeconds": 300
    },
    {
      "id": "provenance",
      "argv": [
        "python3",
        "-B",
        "scripts/update-provenance.py",
        "--check"
      ],
      "timeoutSeconds": 300
    },
    {
      "id": "catalogue",
      "argv": [
        "sh",
        "-c",
        "exec .venv/bin/python -B -m unittest tests.test_own_deliveries.StandingBinding"
      ],
      "timeoutSeconds": 300
    },
    {
      "id": "durable-text",
      "argv": [
        "sh",
        "-c",
        "exec .venv/bin/python -B -m unittest tests.test_linear_qualification.LinearQualificationTests.test_durable_corpus_contains_no_plan_or_ticket_ids"
      ],
      "timeoutSeconds": 300
    }
  ],
  "hooks": {
    "lead.may-stop": "enforce"
  }
}
