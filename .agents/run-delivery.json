{
  "schemaVersion": "delivery-flow/1",
  "branchPattern": "claude/{key}",
  "gates": [
    {
      "id": "validate-registry",
      "argv": [
        "python3",
        "-B",
        "scripts/validate-registry.py"
      ],
      "timeoutSeconds": 300
    },
    {
      "id": "provenance",
      "argv": [
        "python3",
        "-B",
        "scripts/update-provenance.py",
        "--check"
      ],
      "timeoutSeconds": 300
    },
    {
      "id": "guard-linear-qualification",
      "argv": [
        "sh",
        "-c",
        ".venv/bin/python -B scripts/run-tests.py --workers 4 -p test_linear_qualification.py"
      ],
      "timeoutSeconds": 900
    },
    {
      "id": "guard-registry",
      "argv": [
        "sh",
        "-c",
        ".venv/bin/python -B tests/test_registry.py"
      ],
      "timeoutSeconds": 900
    }
  ],
  "hooks": {
    "lead.may-stop": "enforce"
  }
}
