{
  "schemaVersion": "orchestration-binding/1",
  "base": {
    "remote": "origin",
    "ref": "main"
  },
  "bases": [
    "main",
    "integrate/*"
  ],
  "workRoot": ".orchestration/work",
  "candidate": [
    "python3",
    "-B",
    ".agents/delivery/candidate.py",
    "{candidate}",
    "{base}"
  ],
  "prepare": [
    [
      "python3",
      "-B",
      "scripts/bootstrap-test-environment.py"
    ]
  ],
  "hooks": "bypass",
  "regenerable": {
    "paths": [
      "provenance.lock.json"
    ],
    "regenerators": [
      [
        ".venv/bin/python",
        "-B",
        "scripts/update-provenance.py"
      ]
    ],
    "listings": [
      {
        "path": "provenance.lock.json",
        "argv": [
          "python3",
          "-B",
          "scripts/update-provenance.py",
          "--list-outputs"
        ]
      }
    ]
  },
  "postSync": [],
  "leadInputs": [],
  "profiles": {},
  "provider": null,
  "alwaysRun": [
    {
      "id": "validate-registry",
      "argv": [
        ".venv/bin/python",
        "-B",
        "scripts/validate-registry.py"
      ],
      "cwd": ".",
      "reasons": [
        "Every candidate keeps the corpus valid."
      ],
      "prerequisites": [],
      "timeoutSeconds": 300
    },
    {
      "id": "plan-record-fixtures",
      "argv": [
        ".venv/bin/python",
        "-B",
        "scripts/run-tests.py",
        "--workers",
        "4",
        "-p",
        "test_delivery_views_plan_fixtures.py"
      ],
      "cwd": ".",
      "reasons": [
        "The captured plan records must match what the state tool and runner write today, so every change to a record's shape is checked against them (V26-3306: fullHealth caught a miss after V26-3260)."
      ],
      "prerequisites": [],
      "timeoutSeconds": 600
    }
  ],
  "fallback": [
    {
      "id": "full-suite",
      "argv": [
        ".venv/bin/python",
        "-B",
        "scripts/run-tests.py",
        "--workers",
        "4"
      ],
      "cwd": ".",
      "reasons": [
        "No lead selection: run everything."
      ],
      "prerequisites": [],
      "timeoutSeconds": 5400
    }
  ],
  "selection": {
    "lead": true,
    "catalogue": [
      {
        "id": "tests.test_adoption",
        "argv": [
          ".venv/bin/python",
