    "guards": [
      "tests.test_linear_qualification",
      "tests.test_registry"
    ],
    "readers": [
      {
        "paths": [
          "skills/delivery-views/scripts/snapshot.py"
        ],
        "checks": [
          "tests.test_delivery_views_adopter",
          "tests.test_delivery_views_snapshots"
        ]
      },
      {
        "paths": [
          "docs/solutions/**"
        ],
        "checks": [
          "tests.test_compound_learning_corpus"
        ]
      }
    ]
  },
  "checkOutput": {
    "failurePattern": "^(?:FAIL|ERROR): (?P<id>\\S+)"
  },
  "checkTimeoutSeconds": 1800,
  "checkTimeoutCeiling": 5400,
  "environment": {
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "ready": [
    "gh",
    "pr",
    "ready",
    "{branch}",
    "--repo",
    "kwam1na/agent-skills"
  ],
  "merge": [
    "gh",
    "pr",
    "merge",
    "{branch}",
    "--repo",
    "kwam1na/agent-skills",
    "--squash",
    "--delete-branch",
    "--match-head-commit",
    "{expectedHead}"
  ],
  "release": [],
  "fullHealth": [
    ".venv/bin/python",
    "-B",
    "scripts/run-tests.py",
    "--workers",
    "4"
  ],
  "leases": [],
  "state": {
    "directory": ".orchestration/state",
    "renderers": [
      {
        "id": "markdown",
        "builtin": "markdown",
        "output": "delivery.md"
      },
      {
        "id": "page",
        "builtin": "static-page",
        "output": "delivery.html"
      },
      {
        "id": "line-map",
        "argv": [
          "python3",
          "-B",
          ".agent-skills/current/skills/delivery-views/scripts/render.py",
          "line-map",
          "--config",
          ".agents/delivery-views.json",
          "--binding",
          ".agents/orchestration.json",
          "--state-dir",
          "{stateDirectory}"
        ],
        "output": "line-map.html",
        "timeoutSeconds": 30
      },
      {
        "id": "delivery-history",
        "argv": [
          "python3",
          "-B",
          ".agent-skills/current/skills/delivery-views/scripts/render.py",
          "history",
          "--config",
          ".agents/delivery-views.json",
          "--binding",
          ".agents/orchestration.json",
          "--state-dir",
          "{stateDirectory}"
        ],
        "output": "delivery-history.html",
        "timeoutSeconds": 60
      }
    ],
    "publishers": [
      {
        "id": "tracker",
        "argv": [
          "python3",
          "-B",
          ".agent-skills/current/skills/run-delivery/scripts/tracker_publisher.py",
          "--state-dir",
          "{stateDirectory}"
        ],
        "timeoutSeconds": 600
      }
    ],
    "trackerSnapshot": {
      "argv": [
        "python3",
        "-B",
        ".agent-skills/current/skills/delivery-views/scripts/snapshot.py",
        "--kind",
        "linear",
        "--parent",
        "{parent}",
        "--token-env",
        "LINEAR_API_KEY",
        "--timeout-seconds",
        "100"
      ],
      "timeoutSeconds": 120
    },
    "forgeSnapshot": {
      "argv": [
        "python3",
        "-B",
        ".agent-skills/current/skills/delivery-views/scripts/snapshot.py",
        "--kind",
        "github",
        "--owner",
        "kwam1na",
        "--repo",
        "agent-skills",
        "--binding",
        ".agents/orchestration.json",
        "--state-dir",
        "{stateDirectory}",
        "--subject-pattern",
        "V26-[0-9]+",
        "--token-env",
        "GITHUB_TOKEN",
        "--timeout-seconds",
        "160"
      ],
      "timeoutSeconds": 180
    },
    "refreshSeconds": 180,
    "liveHome": "line-map"
  },
  "fullHealthTimeoutSeconds": 5400
}
