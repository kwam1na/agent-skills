{
  "schemaVersion": "orchestration-binding/1",
  "base": {
    "remote": "origin",
    "ref": "main"
  },
  "workRoot": ".orchestration/work",
  "candidate": [
    "python3",
    "-B",
    ".agents/delivery/candidate.py",
    "{candidate}"
  ],
  "prepare": [
    [
      "python3",
      "-B",
      "scripts/bootstrap-test-environment.py"
    ]
  ],
  "hooks": "bypass",
  "regenerable": {
    "paths": [
      "provenance.lock.json"
    ],
    "regenerators": [
      [
        ".venv/bin/python",
        "-B",
        "scripts/update-provenance.py"
      ]
    ]
  },
  "postSync": [],
  "leadInputs": [],
  "profiles": {},
  "provider": null,
  "alwaysRun": [
    {
      "id": "validate-registry",
      "argv": [
        ".venv/bin/python",
        "-B",
        "scripts/validate-registry.py"
      ],
      "cwd": ".",
      "reasons": [
        "Every candidate keeps the corpus valid."
      ],
      "prerequisites": [],
      "timeoutSeconds": 300
    }
  ],
  "fallback": [
    {
      "id": "full-suite",
      "argv": [
        ".venv/bin/python",
        "-B",
        "scripts/run-tests.py",
        "--workers",
        "4"
      ],
      "cwd": ".",
      "reasons": [
        "No lead selection: run everything."
      ],
      "prerequisites": [],
      "timeoutSeconds": 3000
    }
  ],
  "selection": {
    "lead": true
  },
  "checkOutput": {
    "failurePattern": "^(?:FAIL|ERROR): (?P<id>\\S+)"
  },
  "checkTimeoutSeconds": 1800,
  "checkTimeoutCeiling": 3600,
  "environment": {
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "ready": [
    "gh",
    "pr",
    "ready",
    "{branch}",
    "--repo",
    "kwam1na/agent-skills"
  ],
  "merge": [
    "gh",
    "pr",
    "merge",
    "{branch}",
    "--repo",
    "kwam1na/agent-skills",
    "--squash",
    "--delete-branch",
    "--match-head-commit",
    "{expectedHead}"
  ],
  "release": [],
  "fullHealth": [
    ".venv/bin/python",
    "-B",
    "scripts/run-tests.py",
    "--workers",
    "4"
  ],
  "leases": [],
  "state": {
    "directory": ".orchestration/state",
    "renderers": [
      {
        "id": "markdown",
        "builtin": "markdown",
        "output": "delivery.md"
      },
      {
        "id": "page",
        "builtin": "static-page",
        "output": "delivery.html"
      },
      {
        "id": "line-map",
        "argv": [
          "python3",
          "-B",
          ".agent-skills/current/skills/delivery-views/scripts/render.py",
          "line-map",
          "--config",
          ".agents/delivery-views.json",
          "--binding",
          ".agents/orchestration.json",
          "--state-dir",
          "{stateDirectory}"
        ],
        "output": "line-map.html",
        "timeoutSeconds": 30
      },
      {
        "id": "delivery-history",
        "argv": [
          "python3",
          "-B",
          ".agent-skills/current/skills/delivery-views/scripts/render.py",
          "history",
          "--config",
          ".agents/delivery-views.json",
          "--binding",
          ".agents/orchestration.json",
          "--state-dir",
          "{stateDirectory}"
        ],
        "output": "delivery-history.html",
        "timeoutSeconds": 60
      }
    ],
    "publishers": [
      {
        "id": "tracker",
        "kind": "host"
      }
    ],
    "trackerSnapshot": {
      "argv": [
        "python3",
        "-B",
        ".agent-skills/current/skills/delivery-views/scripts/snapshot.py",
        "--kind",
        "linear",
        "--parent",
        "{parent}",
        "--token-env",
        "LINEAR_API_KEY",
        "--timeout-seconds",
        "100"
      ],
      "timeoutSeconds": 120
    },
    "forgeSnapshot": {
      "argv": [
        "python3",
        "-B",
        ".agent-skills/current/skills/delivery-views/scripts/snapshot.py",
        "--kind",
        "github",
        "--owner",
        "kwam1na",
        "--repo",
        "agent-skills",
        "--binding",
        ".agents/orchestration.json",
        "--state-dir",
        "{stateDirectory}",
        "--subject-pattern",
        "V26-[0-9]+",
        "--token-env",
        "GITHUB_TOKEN",
        "--timeout-seconds",
        "160"
      ],
      "timeoutSeconds": 180
    },
    "refreshSeconds": 180,
    "liveHome": "line-map"
  }
}
