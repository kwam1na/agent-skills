{
  "$id": "urn:agent-skills:orchestrate-work:delivery-journal:1",
  "title": "delivery-journal/1",
  "description": "One append-only journal entry. The journal is a file of these entries, one per line, with ids allocated by the state tool in sequence from 1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "at",
    "kind",
    "lane",
    "subject",
    "summary"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "kind": {
      "enum": [
        "lane.assigned",
        "candidate.handed",
        "check.started",
        "check.finished",
        "candidate.merged",
        "candidate.stopped",
        "base.broken",
        "base.repaired",
        "lease.granted",
        "lease.released",
        "release.started",
        "release.finished",
        "finish.met",
        "decision.recorded",
        "blocker.recorded",
        "delivery.closed"
      ]
    },
    "lane": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "subject": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
