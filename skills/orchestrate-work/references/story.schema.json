{
  "$id": "urn:agent-skills:orchestrate-work:story:1",
  "title": "story/1",
  "description": "A delivery's story, as the narrator tells it from the journal: a digest, chapters that each end at a landing, the beats inside them with the altitudes each shows at, and the threads that gather each setback. It holds instants and the durations between two entries, never a time measured to now.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "state", "digest", "chapters", "beats", "threads"],
  "properties": {
    "schemaVersion": {"const": "story/1"},
    "state": {"description": "Whether the delivery is still running or has closed.", "enum": ["open", "closed"]},
    "digest": {"$ref": "#/$defs/digest"},
    "chapters": {"type": "array", "items": {"$ref": "#/$defs/chapter"}},
    "beats": {"type": "array", "items": {"$ref": "#/$defs/beat"}},
    "threads": {"type": "array", "items": {"$ref": "#/$defs/thread"}}
  },
  "$defs": {
    "instant": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "seconds": {"description": "Whole seconds between two entries.", "type": "integer", "minimum": 0},
    "entryIds": {"description": "Journal entries by id.", "type": "array", "items": {"type": "integer", "minimum": 1}},
    "chapterId": {"type": "string", "pattern": "^c[1-9][0-9]*$"},
    "beatId": {"type": "string", "pattern": "^b[1-9][0-9]*$"},
    "threadId": {"type": "string", "pattern": "^t[1-9][0-9]*$"},
    "subjects": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "words": {
      "description": "What a reader reads: a head and a line, in the page's voice.",
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "line"],
      "properties": {"head": {"type": "string", "minLength": 1}, "line": {"type": "string"}}
    },
    "digest": {
      "description": "What the story holds: the pieces landed, when the delivery started and closed, its setbacks and what they cost, and the lead's decisions.",
      "type": "object",
      "additionalProperties": false,
      "required": ["landed", "pieces", "startedAt", "closedAt", "took", "setbacks", "decisions", "words"],
      "properties": {
        "landed": {"type": "integer", "minimum": 0},
        "pieces": {"type": "integer", "minimum": 0},
        "startedAt": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/instant"}]},
        "closedAt": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/instant"}]},
        "took": {"description": "From the first entry to the close, once closed.", "anyOf": [{"type": "null"}, {"$ref": "#/$defs/seconds"}]},
        "setbacks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["closed", "cost", "standing"],
          "properties": {
            "closed": {"type": "integer", "minimum": 0},
            "cost": {"description": "What the closed setbacks cost, together.", "$ref": "#/$defs/seconds"},
            "standing": {
              "description": "Each setback still open, by its thread and the instant it opened.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["thread", "openedAt"],
                "properties": {"thread": {"$ref": "#/$defs/threadId"}, "openedAt": {"$ref": "#/$defs/instant"}}
              }
            }
          }
        },
        "decisions": {"description": "The decisions the lead recorded.", "type": "integer", "minimum": 0},
        "words": {"$ref": "#/$defs/words"}
      }
    },
    "chapter": {
      "description": "A stretch of the delivery: the start, up to its first landing; each landing, from the one before; and what came after the last.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "form", "subject", "pieceTitle", "at", "entries", "beats", "standing", "notLanded", "words"],
      "properties": {
        "id": {"$ref": "#/$defs/chapterId"},
        "form": {"enum": ["start", "landing", "finish"]},
        "subject": {"description": "The piece that landed, for a landing.", "anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "pieceTitle": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "at": {"description": "The landing's instant; the first entry's for the start; the last entry's for the finish.", "$ref": "#/$defs/instant"},
        "entries": {"$ref": "#/$defs/entryIds"},
        "beats": {"type": "array", "items": {"$ref": "#/$defs/beatId"}},
        "standing": {"description": "The setbacks opened in an earlier chapter that still stood when this one began.", "type": "array", "items": {"$ref": "#/$defs/threadId"}},
        "notLanded": {"description": "For a closed delivery's last chapter, the pieces that never landed.", "$ref": "#/$defs/subjects"},
        "words": {
          "type": "object",
          "additionalProperties": false,
          "required": ["head", "line", "standing"],
          "properties": {
            "head": {"type": "string", "minLength": 1},
            "line": {"type": "string"},
            "standing": {"description": "One line for each setback still standing.", "type": "array", "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "beat": {
      "description": "One thing a reader reads: an entry, a batch's starts, a run of bookkeeping, or a setback told whole at the headline altitude.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "chapter", "form", "altitudes", "at", "entries", "thread", "kind", "tone", "label", "words"],
      "properties": {
        "id": {"$ref": "#/$defs/beatId"},
        "chapter": {"$ref": "#/$defs/chapterId"},
        "form": {"enum": ["entry", "batch", "bookkeeping", "thread"]},
        "altitudes": {
          "description": "The altitudes it shows at.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["headline", "story", "everything"]}
        },
        "at": {"$ref": "#/$defs/instant"},
        "entries": {"description": "The entries it tells.", "type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "thread": {"description": "The thread its entries belong to.", "anyOf": [{"type": "null"}, {"$ref": "#/$defs/threadId"}]},
        "kind": {"description": "Its entries' kind, or a thread's opening kind; none for a run of bookkeeping.", "anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "tone": {"enum": ["landed", "ready", "decision", "problem", "note"]},
        "label": {"type": "string", "minLength": 1},
        "words": {"$ref": "#/$defs/words"}
      }
    },
    "thread": {
      "description": "A setback: its opening, every entry linked to it, the entry that answered it, and what it cost.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "chapter", "beat", "opening", "closing", "openedAt", "closedAt", "cost", "state", "entries", "cause", "heldUp", "words"],
      "properties": {
        "id": {"$ref": "#/$defs/threadId"},
        "chapter": {"$ref": "#/$defs/chapterId"},
        "beat": {"description": "The beat that tells it at the headline altitude.", "$ref": "#/$defs/beatId"},
        "opening": {"type": "integer", "minimum": 1},
        "closing": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
        "openedAt": {"$ref": "#/$defs/instant"},
        "closedAt": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/instant"}]},
        "cost": {"description": "From its opening to its closing; none while it stands.", "anyOf": [{"type": "null"}, {"$ref": "#/$defs/seconds"}]},
        "state": {"enum": ["open", "closed"]},
        "entries": {"$ref": "#/$defs/entryIds"},
        "cause": {"description": "What went wrong first: the problems its opening happened because of.", "$ref": "#/$defs/entryIds"},
        "heldUp": {"description": "The other pieces it stopped.", "$ref": "#/$defs/subjects"},
        "words": {"$ref": "#/$defs/words"}
      }
    }
  }
}
