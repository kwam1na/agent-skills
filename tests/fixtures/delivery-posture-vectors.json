{
  "schemaVersion": "delivery-posture-vectors/1",
  "path": ".agents/delivery-posture.json",
  "base": "origin/main",
  "blankCharacters": "A reason is blank when it is empty or holds only these: U+0009-U+000D, U+001C-U+0020, U+0085, U+00A0, U+1680, U+2000-U+200A, U+2028, U+2029, U+202F, U+205F, U+3000, U+FEFF. That is what Python's strip and JavaScript's trim remove, together.",
  "setup": {
    "base": "What the remote's main holds at the path: none, or a blob (text or base64, padded with trailing spaces to padTo bytes), a symlink, a tree or a submodule. Unless fetch or ref says otherwise, it reaches the remote after the reader's clone last fetched, so a reader that doesn't fetch reads a tip with no file.",
    "fetch": "fails: the clone has fetched the tip, and the remote is then unreachable.",
    "git": "fails or hangs: every git command the reader runs exits 1, or never returns and leaves a child holding its output.",
    "ref": "missing: neither the remote nor the clone has the branch.",
    "shadow": "A local branch and a tag, both named origin/main, hold this at the path."
  },
  "vectors": [
